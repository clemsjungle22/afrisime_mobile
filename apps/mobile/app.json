{
  "expo": {
    "name": "AfriSime",
    "slug": "afrisime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tg.afrisime.market"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f3d2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tg.afrisime.market",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "afrisime",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AfriSime utilise votre position, si vous l’acceptez, pour aider le livreur à trouver votre adresse."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0f3d2e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfriSime utilise vos photos pour vérifier votre identité, si vous le demandez.",
          "cameraPermission": "AfriSime utilise l’appareil photo pour photographier votre pièce d’identité et votre visage."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
