# Variables EXPO_PUBLIC_* : embarquées dans le bundle, donc PUBLIQUES. Aucun secret ici.
# Adresse du serveur. Vide en développement : l'app prend l'adresse du PC (celle de Metro) sur le port 4000.
EXPO_PUBLIC_API_URL=
# true = mode démo (données simulées dans l'app, sans serveur) ; false = vrai serveur (apps/api)
EXPO_PUBLIC_API_MOCK=false
