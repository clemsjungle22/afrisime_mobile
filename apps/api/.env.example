# Copier en .env.local (jamais commité) et compléter.

# Supabase → Connect → « Transaction pooler » (port 6543). Remplacer [YOUR-PASSWORD].
DATABASE_URL=

# Secret de signature des jetons (≥ 32 caractères aléatoires). Généré automatiquement en local.
AUTH_SECRET=

# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info

# Envoi des SMS. « console » : le code s'affiche dans le terminal du serveur (développement uniquement).
SMS_PROVIDER=console
# Code de connexion fixe pour les essais (6 chiffres). Laisser vide pour un code aléatoire. Interdit en production.
OTP_DEV_CODE=

# Paiement. « simulated » : …0002 refusé, …0003 expiré, sinon confirmé en ~5 s. Interdit en production.
PAYMENT_PROVIDER=simulated
# Secret de signature des webhooks de paiement (≥ 32 caractères). Vide = dérivé d'AUTH_SECRET en développement.
PAYMENT_WEBHOOK_SECRET=
# Développement : les commandes avancent seules (préparation, livraison…). Interdit en production.
ORDER_SIMULATION=false
# Secret du planificateur (≥ 32 caractères) pour POST /v1/internal/jobs/tick. Vide = route désactivée.
CRON_SECRET=

# Clé de chiffrement des secrets 2FA de l'équipe (≥ 32 caractères). Obligatoire en production ;
# vide en développement = dérivée d'AUTH_SECRET. Ne jamais la changer sans réactiver les 2FA.
ADMIN_ENCRYPTION_KEY=

# Dossier des photos du catalogue (stockage sur le disque du serveur, en développement).
MEDIA_DIR=.media
