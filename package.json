{
  "name": "afrisime",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @afrisime/mobile --",
    "start:tunnel": "npm run start:tunnel -w @afrisime/mobile --",
    "start:clear": "npm run start:clear -w @afrisime/mobile --",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/mobile",
    "test": "npm test -w @afrisime/shared && npm test -w @afrisime/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1"
  }
}
