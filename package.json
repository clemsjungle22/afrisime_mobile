{
  "name": "afrisime",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @afrisime/mobile",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/mobile",
    "test": "npm test -w @afrisime/shared"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1"
  }
}
